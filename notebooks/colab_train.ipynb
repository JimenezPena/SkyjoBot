   "source": [
    "# SkyjoBot en Colab\n",
    "\n",
    "Clona el repo, guarda todo en Drive (la sesión gratuita se corta sin avisar) y lanza `train.py`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "OUT = '/content/drive/MyDrive/skyjo'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "REPO = 'https://github.com/JimenezPena/SkyjoBot.git'   # ajusta si hace falta\n",
    "import os\n",
    "if not os.path.exists('/content/SkyjoBot'):\n",
    "    !git clone $REPO /content/SkyjoBot\n",
    "%cd /content/SkyjoBot\n",
    "!git pull"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "VERSION = 'v5_0'      # v4_2 | v5_0\n",
    "!python train.py --version $VERSION --out-dir /content/drive/MyDrive/skyjo  --set CKPT_DIR=checkpoints_5.6 SAVE_PATH=skyjo_dqn_model_5.6.pth NUM_EPISODIOS=30000        RECOMPENSA_REF="'mejor'" RECOMPENSA_FINAL=5.0  BARAJAS_SIMETRICAS=False"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!python evaluate.py torneo --version $VERSION --ckpt-dir $OUT/checkpoints_5.6   # ajusta el nombre de la carpeta"
   ]
  }
